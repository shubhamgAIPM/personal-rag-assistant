# Frontend (safe to expose ONLY if RLS is correctly configured)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local isolation test only (scripts/isolation-test.mjs). Use throwaway
# test accounts on a non-production project.
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=

# Server-side only. Set these as Supabase Edge Function secrets
# (`supabase secrets set ...`). NEVER put them in a VITE_ variable.
# GROQ_API_KEY=
# GROQ_MODEL=
